<Application xmlns="https://github.com/avaloniaui"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:local="using:WestcoastEducation.Desktop"

             x:Class="WestcoastEducation.Desktop.App"

             RequestedThemeVariant="Light">
 
  <Application.DataTemplates>
<local:ViewLocator />
</Application.DataTemplates>
 
  <!-- Colors and sizes, used everywhere with {DynamicResource ...} -->
<Application.Resources>
<ResourceDictionary>
<ResourceDictionary.MergedDictionaries>
<ResourceInclude Source="avares://WestcoastEducation.Desktop/Styles/Colors.axaml" />
</ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
</Application.Resources>
 
  <Application.Styles>
<FluentTheme />
<StyleInclude Source="avares://WestcoastEducation.Desktop/Styles/AppStyles.axaml" />
</Application.Styles>
 
</Application>