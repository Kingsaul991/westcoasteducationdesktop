<UserControl xmlns="https://github.com/avaloniaui"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="using:WestcoastEducation.Desktop.ViewModels"

             xmlns:m="using:WestcoastEducation.Desktop.Models"

             x:Class="WestcoastEducation.Desktop.Views.CoursesView"

             x:DataType="vm:CoursesViewModel">
 
  <Grid ColumnDefinitions="*,360">
 
    <!-- Left: list of courses -->
<Border Classes="card" Grid.Column="0" Margin="0,0,16,0">
<DockPanel>
<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
<TextBlock Classes="heading" Text="Courses" Margin="0" VerticalAlignment="Center" />
<Button Content="Refresh" Command="{Binding LoadCommand}" />
</StackPanel>
 
        <TextBlock DockPanel.Dock="Bottom" Classes="muted" Text="{Binding Message}"

                   TextWrapping="Wrap" Margin="0,8,0,0" />
 
        <ListBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}">
<ListBox.ItemTemplate>
<DataTemplate x:DataType="m:Course">
<StackPanel Spacing="2" Margin="0,4">
<TextBlock FontWeight="SemiBold">
<Run Text="{Binding CourseNumber}" />
<Run Text=" - " />
<Run Text="{Binding Title}" />
</TextBlock>
<TextBlock Classes="muted">
<Run Text="{Binding DeliveryMode}" />
<Run Text=" | " />
<Run Text="{Binding Period}" />
<Run Text=" | " />
<Run Text="{Binding Duration}" />
<Run Text="{Binding DurationUnit}" />
</TextBlock>
<TextBlock Classes="muted">
<Run Text="Teacher: " />
<Run Text="{Binding Teacher}" />
</TextBlock>
</StackPanel>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
</DockPanel>
</Border>
 
    <!-- Right: form for adding / editing -->
<Border Classes="card" Grid.Column="1">
<ScrollViewer>
<StackPanel Spacing="6">
<TextBlock Classes="heading" Text="{Binding FormHeading}" />
 
          <TextBlock Text="Course number" />
<TextBox Text="{Binding CourseNumber}" PlaceholderText="e.g. WCE-101" />
 
          <TextBlock Text="Title" />
<TextBox Text="{Binding Title}" />
 
          <TextBlock Text="Duration" />
<StackPanel Orientation="Horizontal" Spacing="8">
<NumericUpDown Value="{Binding Duration}" Minimum="1" Maximum="365"

                           FormatString="0" Width="140" />
<ComboBox ItemsSource="{Binding DurationUnits}"

                      SelectedItem="{Binding DurationUnit}" Width="120" />
</StackPanel>
 
          <TextBlock Text="Start date" />
<CalendarDatePicker SelectedDate="{Binding StartDate}" HorizontalAlignment="Stretch" />
 
          <TextBlock Text="End date" />
<CalendarDatePicker SelectedDate="{Binding EndDate}" HorizontalAlignment="Stretch" />
 
          <CheckBox Content="Distance course" IsChecked="{Binding IsDistance}" />
 
          <TextBlock Text="Teacher" />
<ComboBox ItemsSource="{Binding TeacherNames}" SelectedItem="{Binding Teacher}"

                    PlaceholderText="Choose a teacher" HorizontalAlignment="Stretch" />
 
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
<Button Classes="primary" Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" />
<Button Content="New" Command="{Binding NewCommand}" />
<Button Classes="danger" Content="Delete" Command="{Binding DeleteCommand}" />
</StackPanel>
</StackPanel>
</ScrollViewer>
</Border>
 
  </Grid>
</UserControl>